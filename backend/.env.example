# ==============================================================================
# FoodWise AI Backend — Environment Configuration (.env.example)
# Placeholders ONLY — Copy to .env and configure for your environment
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Gemini AI API Key (Optional in development - falls back to deterministic local NLP)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cryptographic Provenance Master Key (REQUIRED in production)
# In production (NODE_ENV=production), the backend strictly refuses to start if unset.
PROVENANCE_SIGNING_SECRET=your_strong_cryptographic_secret_key_minimum_32_chars

# Production CORS Security Configuration
# Explicitly allowed frontend origins in production (comma-separated, without trailing slashes)
FRONTEND_URL=https://your-production-domain.com
ALLOWED_ORIGINS=https://your-production-domain.com,https://app.your-production-domain.com

# ==============================================================================
# Supabase PostgreSQL Database Configuration (Optional - falls back to demo mode)
# ==============================================================================
# 1. Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# 2. Project API Keys -> "anon" / "public" (Safe for standard queries with RLS)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Project API Keys -> "service_role" / "secret" (PRIVILEGED - SERVER ONLY!)
#    CRITICAL WARNING: NEVER EXPOSE THIS KEY IN THE FRONTEND CODE.
#    This key bypasses all Postgres Row Level Security (RLS) policies.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

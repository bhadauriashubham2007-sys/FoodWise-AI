# ==============================================================================
# FoodWise AI Frontend — Environment Configuration
# ==============================================================================

# Backend API base URL (Vite dev proxy points to http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000/api

# ==============================================================================
# Supabase Client Configuration (OPTIONAL - For direct frontend auth sync)
# ==============================================================================
# 1. Project URL from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co

# 2. Public / Anon Publishable Key
#    This key is safe in client bundles because queries are restricted by RLS.
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# ------------------------------------------------------------------------------
# ⚠️ CRITICAL SECURITY WARNING:
# NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend .env or client code!
# The service role key bypasses all Row Level Security and must stay on the backend.
# ------------------------------------------------------------------------------
